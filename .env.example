# Copy to `.env` and fill in for real integrations. `python -m legal_intel` loads
# `.env` automatically (existing environment variables win). `.env` is git-ignored
# — never commit real secrets. With NOTHING set, the system runs fully offline
# (local Notion backend + fake LLM, no tokens, no network).

# --- Backend selection ----------------------------------------------------- #
LEGAL_INTEL_NOTION_BACKEND=local     # local | notion
LEGAL_INTEL_LLM_BACKEND=fake         # fake | anthropic

# --- Paths (optional) ------------------------------------------------------ #
# LEGAL_INTEL_CONFIG=./config
# LEGAL_INTEL_LOCAL_STORE=./data/store.local.json   # persist local store between runs

# --- Real Notion (only when LEGAL_INTEL_NOTION_BACKEND=notion) -------------- #
# Internal integration token; the integration must be shared on the "Mouhalis
# Legal Intelligence" page. NOTION_DATABASE_ID = the Legal Events DB id.
# NOTION_TOKEN=secret_xxx
# NOTION_DATABASE_ID=13f7a244fb2c49df8585899669307450   # Legal Events V2 (thkalfas pipeline)
# NOTION_DATA_SOURCE_ID=c241a51e-b5d1-4dd2-87bd-c82562f72404  # V2 data source (optional, auto-resolved)
# NOTION_PARENT_PAGE=39ec8c56f54c816aa48cd9b67c321533   # Mouhalis Legal Intelligence
# NOTION_SOURCE_HEALTH_DB_ID=xxxxxxxx   # optional: auto-update the Source Health board each run

# --- Real Claude (only when LEGAL_INTEL_LLM_BACKEND=anthropic) -------------- #
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- Tier-3 commercial inbox (only if that source is enabled) -------------- #
# IMAP host + password for the dedicated shared inbox. The inbox address itself
# is in config/sources.yaml; these var NAMES are referenced from that source's
# options (imap_host_env / imap_password_env).
# LEGAL_INTEL_IMAP_HOST=imap.example.com
# LEGAL_INTEL_IMAP_PASSWORD=xxx
